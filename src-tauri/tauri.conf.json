{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Link Selector",
  "version": "0.2.14",
  "identifier": "io.github.kmr-gks.link-selector",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Link Selector",
        "width": 460,
        "height": 465,
        "minWidth": 360,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "capabilities": [
        {
          "identifier": "picker",
          "windows": [
            "main",
            "picker-*"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
